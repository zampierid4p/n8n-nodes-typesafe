{
  "name": "n8n-nodes-typesafe",
  "version": "0.3.1",
  "description": "n8n community node for TypeSafe System One models: ask Choice, Noul and Score questions and get calibrated, typed answers",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "typesafe",
    "jev",
    "system-one",
    "ai",
    "classification",
    "structured-output"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zampierid4p/n8n-nodes-typesafe",
  "author": {
    "name": "Marco Zampieri",
    "email": "marco.zampieri@data4prime.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zampierid4p/n8n-nodes-typesafe.git"
  },
  "bugs": {
    "url": "https://github.com/zampierid4p/n8n-nodes-typesafe/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "test": "npm run build && node --test test/node.test.js"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TypeSafeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TypeSafe/TypeSafe.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
